<?xml version="1.0" encoding="utf-8"?>
<!-- Aucune sauvegarde cloud ni transfert d'appareil à appareil : la session
     (chiffrée avec une clé du Keystore, propre à cet appareil) et le cache
     local ne doivent pas être copiés ailleurs. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
