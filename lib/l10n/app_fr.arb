  "privacyWhoTitle": "Qui est responsable ?",
  "privacyWhoParagraph1": "Le Bierodex est édité par {publisher}, responsable du traitement de tes données. Contact : {contact}.",
  "@privacyWhoParagraph1": {
    "placeholders": {
